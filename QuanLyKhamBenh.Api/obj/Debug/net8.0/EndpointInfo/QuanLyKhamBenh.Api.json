  "components": {
    "schemas": {
      "BookAppointmentDto": {
        "required": [
          "appointmentDatetime",
          "specialtyId"
        ],
        "type": "object",
        "properties": {
          "doctorId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "specialtyId": {
            "type": "integer",
            "format": "int32"
          },
          "appointmentDatetime": {
            "type": "string",
            "format": "date-time"
          },
          "symptoms": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DoctorCreateRequest": {
        "required": [
          "email",
          "fullName",
          "password",
          "phone"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "phone": {
            "minLength": 1,
            "type": "string",
            "format": "tel"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          },
          "specialtyId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "qualifications": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DoctorDto": {
        "type": "object",
        "properties": {
          "doctorId": {
            "type": "integer",
            "format": "int32"
          },
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "specialtyId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "specialtyName": {
            "type": "string",
            "nullable": true
          },
          "qualifications": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DoctorUpdateRequest": {
        "required": [
          "email",
          "fullName",
          "phone"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "phone": {
            "minLength": 1,
            "type": "string",
            "format": "tel"
          },
          "specialtyId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "qualifications": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
